rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isProjectMember(projectId) {
      return isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.memberUids);
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // User private profiles
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && incoming().uid == userId
        && incoming().email is string
        && incoming().email.size() <= 200
        && (!('displayName' in incoming()) || (incoming().displayName is string && incoming().displayName.size() <= 100));
      allow update: if isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email;
      allow delete: if isOwner(userId);
    }

    // User lookup directory by email for sharing projects
    match /userLookup/{lookupKey} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && incoming().uid == request.auth.uid
        && incoming().email is string
        && incoming().email.size() <= 200
        && incoming().email == request.auth.token.email.lower()
        && lookupKey == incoming().email.replace('[^a-zA-Z0-9]', '_');
      allow delete: if isSignedIn() && existing().uid == request.auth.uid;
    }

    // Project workspaces
    match /projects/{projectId} {
      allow list: if isSignedIn() && (request.auth.uid in resource.data.memberUids);
      allow get: if isSignedIn() && (request.auth.uid in resource.data.memberUids);
      allow create: if isSignedIn()
        && isValidId(projectId)
        && incoming().id == projectId
        && incoming().ownerId == request.auth.uid
        && incoming().ownerEmail is string
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100
        && (!('description' in incoming()) || (incoming().description is string && incoming().description.size() <= 500))
        && incoming().memberUids is list && incoming().memberUids.size() <= 50
        && (request.auth.uid in incoming().memberUids)
        && incoming().memberEmails is list && incoming().memberEmails.size() <= 50;
      allow update: if isSignedIn()
        && isValidId(projectId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && (
          // Case 1: Only the owner may change memberUids / memberEmails
          (existing().ownerId == request.auth.uid
            && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100
            && (!('description' in incoming()) || (incoming().description is string && incoming().description.size() <= 500))
            && incoming().memberUids is list && incoming().memberUids.size() <= 50
            && (existing().ownerId in incoming().memberUids)
            && incoming().memberEmails is list && incoming().memberEmails.size() <= 50
          ) ||
          // Case 2: Collaborators may edit name/description only
          (existing().ownerId != request.auth.uid
            && (request.auth.uid in existing().memberUids)
            && incoming().memberUids == existing().memberUids
            && incoming().memberEmails == existing().memberEmails
            && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100
            && (!('description' in incoming()) || (incoming().description is string && incoming().description.size() <= 500))
          ) ||
          // Case 3: Collaborators may remove only themselves (leave project)
          (existing().ownerId != request.auth.uid
            && (request.auth.uid in existing().memberUids)
            && !(request.auth.uid in incoming().memberUids)
            && incoming().memberUids.size() == existing().memberUids.size() - 1
            && existing().memberUids.hasAll(incoming().memberUids)
            && (existing().ownerId in incoming().memberUids)
            && existing().memberEmails.hasAll(incoming().memberEmails)
            && incoming().memberEmails.size() >= existing().memberEmails.size() - 1
            && incoming().name == existing().name
            && incoming().get('description', '') == existing().get('description', '')
          )
        );
      allow delete: if isSignedIn()
        && isValidId(projectId)
        && existing().ownerId == request.auth.uid;

      // Subcollection: Environments
      match /environments/{environmentId} {
        allow list, get: if isProjectMember(projectId);
        allow create: if isProjectMember(projectId)
          && isValidId(environmentId)
          && incoming().id == environmentId
          && incoming().projectId == projectId
          && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100;
        allow update: if isProjectMember(projectId)
          && isValidId(environmentId)
          && incoming().id == existing().id
          && incoming().projectId == existing().projectId
          && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100;
        allow delete: if isProjectMember(projectId)
          && isValidId(environmentId);

        // Nested Subcollection: Variables
        match /variables/{variableId} {
          allow list, get: if isProjectMember(projectId);
          allow create: if isProjectMember(projectId)
            && isValidId(variableId)
            && incoming().id == variableId
            && incoming().projectId == projectId
            && incoming().environmentId == environmentId
            && incoming().key is string && incoming().key.size() > 0 && incoming().key.size() <= 150
            && incoming().key.matches('^[a-zA-Z0-9_]+$')
            && incoming().value is string && incoming().value.size() <= 10000
            && incoming().isSensitive is bool;
          allow update: if isProjectMember(projectId)
            && isValidId(variableId)
            && incoming().id == existing().id
            && incoming().projectId == existing().projectId
            && incoming().environmentId == existing().environmentId
            && incoming().key is string && incoming().key.size() > 0 && incoming().key.size() <= 150
            && incoming().key.matches('^[a-zA-Z0-9_]+$')
            && incoming().value is string && incoming().value.size() <= 10000
            && incoming().isSensitive is bool;
          allow delete: if isProjectMember(projectId)
            && isValidId(variableId);
        }

        // Nested Subcollection: History (Immutable audit log)
        match /history/{historyId} {
          allow list, get: if isProjectMember(projectId);
          allow create: if isProjectMember(projectId)
            && isValidId(historyId)
            && incoming().id == historyId
            && incoming().projectId == projectId
            && incoming().environmentId == environmentId;
          allow update, delete: if false; // strictly immutable: can never be modified or deleted!
        }
      }
    }
  }
}
